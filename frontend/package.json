{
  "name": "reader-server-frontend",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "fmt": "oxfmt",
    "lint": "oxlint . && eslint .",
    "fix": "eslint --fix .",
    "check": "tsc --noEmit --strict --skipLibCheck",
    "verify": "pnpm fmt:check && pnpm lint && pnpm check && pnpm test",
    "fmt:check": "oxfmt --check",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prepare": "simple-git-hooks",
    "e2e": "./e2e/run.sh"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "copy-to-clipboard": "^4.0.2",
    "d3": "^7.9.0",
    "epubjs": "^0.3.93",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "opencc-js": "^1.4.2",
    "pdfjs-dist": "^6.4.299",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.17",
    "solid-toast": "^0.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.5",
    "@unocss/preset-wind4": "^66.11.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-solid": "^0.18.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.87.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "unocss": "^66.11.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "oxlint --fix",
      "eslint --fix"
    ],
    "*.{ts,tsx,js,mjs,cjs,json,jsonc,css,html,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@12.13.0+sha512.1e55719bf26e809dce5c5084fdebaa64efb3da9038ae5d68a9f8a68311f1a45841c8c3b76a37298c3b66f6bcc80409a9b7f33c78a7168a3e90fb65a5d8235ae4"
}
